# ══════════════════════════════════════════════════════════════
# SentryGate — Intelligent API Gateway
# .gitignore
# ══════════════════════════════════════════════════════════════

# ── Environment variables ──────────────────────────────────────
.env
.env.local
.env.production
.env.*.local

# ── Node.js (gateway + frontend) ──────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock

# ── Build outputs ──────────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ── Python (ml-service) ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment
venv/
env/
.venv/
ENV/

# ML model files (large binary files — regenerate with train.py)
ml-service/model.pkl
ml-service/scaler.pkl
ml-service/data.csv

# Python egg / distribution
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Jupyter notebooks checkpoints ─────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Docker ────────────────────────────────────────────────────
docker-compose.override.yml

# ── MongoDB & Redis data ───────────────────────────────────────
data/
mongo_data/
redis_data/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
pino-*.log

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE & editor files ────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Jest cache ────────────────────────────────────────────────
.jest-cache/
jest_*

# ── Temporary files ───────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ── Autocannon results ────────────────────────────────────────
benchmark-results/
*.bench.json
