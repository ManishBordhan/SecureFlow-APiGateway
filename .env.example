# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=intelligent-api-gateway

# ── MongoDB ────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/gateway_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ── API Key Cache ──────────────────────────────────────────────
API_KEY_CACHE_TTL_SECONDS=60

# ── Rate Limiting ──────────────────────────────────────────────
DEFAULT_RATE_LIMIT_WINDOW_MS=60000
DEFAULT_RATE_LIMIT_MAX=100
RATE_LIMIT_ALGORITHM=tokenBucket

# ── Abuse Detection ────────────────────────────────────────────
ABUSE_SCORE_THRESHOLD=70
ABUSE_BLOCK_TTL_SECONDS=3600

# ── Upstream Routing ───────────────────────────────────────────
UPSTREAM_BASE_URL=https://jsonplaceholder.typicode.com
# UPSTREAM_ROUTES='[{"prefix":"/api/users","target":"http://localhost:4001"}]'

# ── Socket.IO ──────────────────────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:5173

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info